# Makevars.win for Windows
# Compatible with R >= 4.0 (UCRT toolchain)

CXX_STD = CXX17

# Basic optimization flags (cross-platform compatible)
# Note: Avoid -mtune=native as it causes issues on some Windows setups
PKG_CXXFLAGS = -DEIGEN_NO_DEBUG -O2 $(SHLIB_OPENMP_CXXFLAGS)

# Link libraries
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
