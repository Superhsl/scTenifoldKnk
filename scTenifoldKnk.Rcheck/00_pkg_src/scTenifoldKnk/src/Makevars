# Makevars for Unix-like systems (macOS, Linux)
# No OpenMP - uses Eigen's internal SIMD vectorization instead

CXX_STD = CXX14

# Optimization flags
# -DEIGEN_NO_DEBUG: Disable Eigen's runtime checks for speed
PKG_CXXFLAGS = -DEIGEN_NO_DEBUG

# Link libraries (BLAS/LAPACK for optimized linear algebra)
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
