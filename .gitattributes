# Auto detect text files and perform LF normalization
* text=auto

# Force text files to use LF line endings
*.R text eol=lf
*.Rd text eol=lf
*.Rmd text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.c text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.RData binary
*.rds binary
